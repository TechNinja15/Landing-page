# Supabase (from your existing project: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never ship to the client.
# Used only in server actions / route handlers that must bypass RLS
# (e.g. certificate generation, bulk admin imports).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Sheets mirror for /api/leads (server-side only — see
# google-apps-script/appendLead.gs for the deployment steps)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
